# Vercel
.vercel

# Capacitor
# Conserver android/ et ios/ dans git pour faciliter le déploiement
# Mais exclure les fichiers build et cache
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties
android/*.iml
android/.DS_Store
android/captures/
android/.externalNativeBuild/
android/.cxx/

ios/App/Pods/
ios/App/build/
ios/App/*.xcworkspace/xcuserdata/
ios/App/*.xcodeproj/xcuserdata/
ios/App/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/App/DerivedData/
ios/App/.DS_Store

# Build files (déjà dans le .gitignore Angular principal normalement)
dist/
.angular/cache/

# Keystore files (IMPORTANT: ne jamais commit!)
*.keystore
*.jks
*.p12
*.cer
*.mobileprovision
